# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/bvmw_survey
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bvmw_survey
DB_USER=user
DB_PASSWORD=password

# Security Configuration
SECRET_KEY=your-secret-key-here-change-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application Configuration
APP_NAME=BVMW Survey Platform
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=false
TESTING=false

# API Configuration
API_V1_STR=/api/v1
PROJECT_NAME=BVMW Survey Platform
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# Email Configuration
SMTP_TLS=true
SMTP_PORT=587
SMTP_HOST=smtp.gmail.com
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAILS_FROM_EMAIL=noreply@bvmw-survey.com
EMAILS_FROM_NAME=BVMW Survey Platform
EMAIL_RESET_TOKEN_EXPIRE_HOURS=48
EMAIL_TEMPLATES_DIR=app/email-templates
EMAILS_ENABLED=true

# Redis Configuration (optional)
REDIS_URL=redis://localhost:6379/0

# Sentry Configuration (optional)
SENTRY_DSN=

# AWS S3 Configuration (optional, for file uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_S3_REGION=eu-central-1

# OAuth2 Configuration (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE=/var/log/bvmw-survey/app.log

# Monitoring
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090

# Feature Flags
ENABLE_DOCS=true
ENABLE_REDOC=true
ENABLE_OPENAPI=true
ENABLE_USER_REGISTRATION=true
ENABLE_PASSWORD_RECOVERY=true
ENABLE_EMAIL_VERIFICATION=false

# Survey Configuration
MAX_SURVEY_RESPONSES_PER_USER=1
SURVEY_RESPONSE_TIMEOUT_MINUTES=60
ENABLE_ANONYMOUS_RESPONSES=false

# File Upload Configuration
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_EXTENSIONS=pdf,doc,docx,xls,xlsx,png,jpg,jpeg

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Cache Configuration
CACHE_TTL_SECONDS=3600
CACHE_ENABLED=false

# Webhook Configuration
WEBHOOK_SECRET=
WEBHOOK_TIMEOUT_SECONDS=30

# Admin Configuration
FIRST_SUPERUSER_EMAIL=admin@bvmw-survey.com
FIRST_SUPERUSER_PASSWORD=changeme123
FIRST_SUPERUSER_NAME=Admin User