# Frontend Environment Configuration
# Generated by Ansible - Do not edit manually

# API Configuration
VITE_API_URL={{ frontend_api_url | default('http://localhost:8000') }}
VITE_API_TIMEOUT={{ frontend_api_timeout | default(30000) }}

# Application Settings
VITE_APP_NAME={{ app_name | default('Survey Platform') }}
VITE_APP_VERSION={{ app_version | default('1.0.0') }}
VITE_APP_ENV={{ environment | default('production') }}

# Feature Flags
VITE_ENABLE_ANALYTICS={{ enable_analytics | default('false') }}
VITE_ENABLE_DEBUG={{ enable_debug | default('false') }}
VITE_ENABLE_MOCK_DATA={{ enable_mock_data | default('false') }}

# Authentication
VITE_AUTH_TOKEN_KEY={{ auth_token_key | default('access_token') }}
VITE_AUTH_REFRESH_TOKEN_KEY={{ auth_refresh_token_key | default('refresh_token') }}

# Localization
VITE_DEFAULT_LOCALE={{ default_locale | default('de') }}
VITE_SUPPORTED_LOCALES={{ supported_locales | default('de,en') }}

# External Services (if any)
{% if sentry_dsn is defined %}
VITE_SENTRY_DSN={{ sentry_dsn }}
{% endif %}

{% if google_analytics_id is defined %}
VITE_GA_TRACKING_ID={{ google_analytics_id }}
{% endif %}

{% if mapbox_token is defined %}
VITE_MAPBOX_TOKEN={{ mapbox_token }}
{% endif %}