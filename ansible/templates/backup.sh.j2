#!/bin/bash
set -e

# Configuration
BACKUP_DIR="{{ db_backup_path }}"
PROJECT_PATH="{{ project_path }}"
DB_NAME="{{ db_name }}"
DB_USER="{{ db_user }}"
DB_HOST="{{ db_host }}"
DB_PORT="{{ db_port }}"
RETENTION_DAYS="{{ backup_retention_days }}"
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
BACKUP_FILE="${BACKUP_DIR}/survey_backup_${TIMESTAMP}.sql.gz"

# Create backup directory if it doesn't exist
mkdir -p "${BACKUP_DIR}"

# Export password for pg_dump
export PGPASSWORD="{{ db_password }}"

# Create database backup
echo "Starting database backup..."
pg_dump -h "${DB_HOST}" -p "${DB_PORT}" -U "${DB_USER}" -d "${DB_NAME}" --no-password | gzip > "${BACKUP_FILE}"

# Verify backup was created
if [ -f "${BACKUP_FILE}" ]; then
    echo "Backup created successfully: ${BACKUP_FILE}"
    
    # Get file size
    SIZE=$(du -h "${BACKUP_FILE}" | cut -f1)
    echo "Backup size: ${SIZE}"
    
    {% if backup_s3_bucket %}
    # Upload to S3 if configured
    echo "Uploading backup to S3..."
    aws s3 cp "${BACKUP_FILE}" "s3://{{ backup_s3_bucket }}/backups/database/${TIMESTAMP}.sql.gz" \
        --region {{ backup_s3_region }} \
        --storage-class STANDARD_IA
    
    if [ $? -eq 0 ]; then
        echo "Backup uploaded to S3 successfully"
    else
        echo "Failed to upload backup to S3"
    fi
    {% endif %}
else
    echo "Backup failed!"
    exit 1
fi

# Remove old backups
echo "Cleaning up old backups..."
find "${BACKUP_DIR}" -name "survey_backup_*.sql.gz" -type f -mtime +${RETENTION_DAYS} -delete

# Also backup uploaded files if they exist
MEDIA_DIR="${PROJECT_PATH}/media"
if [ -d "${MEDIA_DIR}" ] && [ "$(ls -A ${MEDIA_DIR})" ]; then
    echo "Backing up media files..."
    MEDIA_BACKUP="${BACKUP_DIR}/survey_media_${TIMESTAMP}.tar.gz"
    tar -czf "${MEDIA_BACKUP}" -C "${PROJECT_PATH}" media/
    
    {% if backup_s3_bucket %}
    # Upload media backup to S3
    aws s3 cp "${MEDIA_BACKUP}" "s3://{{ backup_s3_bucket }}/backups/media/${TIMESTAMP}.tar.gz" \
        --region {{ backup_s3_region }} \
        --storage-class STANDARD_IA
    {% endif %}
    
    # Clean old media backups
    find "${BACKUP_DIR}" -name "survey_media_*.tar.gz" -type f -mtime +${RETENTION_DAYS} -delete
fi

# Log backup completion
echo "Backup completed at $(date)"

# Send notification if configured
{% if smtp_host and admin_email %}
if [ -x "$(command -v mail)" ]; then
    echo "Database backup completed successfully at $(date). File: ${BACKUP_FILE}, Size: ${SIZE}" | \
    mail -s "Survey Platform - Backup Successful" {{ admin_email }}
fi
{% endif %}

# Unset password
unset PGPASSWORD

exit 0